# Address you open in a browser, and the address printed on the slip.
# Use this computer's LAN address so a phone on the same Wi-Fi can open it.
# Example: http://192.168.1.20:3000
# Google redirects back to APP_URL/api/calendar/callback.
APP_URL=http://192.168.1.20:3000

# OAuth client from Google Cloud. Calendar is read-only.
# Leave blank until you want the calendar section.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. If empty, the app creates data/session-secret on first run.
SESSION_SECRET=

# Optional. Token for a remotely managed Cloudflare Tunnel.
# Leave blank for local use. See docs/hosting.md.
TUNNEL_TOKEN=
